# OptiMon — variáveis de ambiente do FRONTEND (Vite/Vercel, seção 7/8).
#
# Regra de ouro (seção 33/53): o frontend NUNCA usa SUPABASE_SERVICE_ROLE_KEY e NUNCA
# acessa o banco diretamente para regras de negócio — só a ANON_KEY (pública por design,
# só habilita auth.signInWithPassword/signOut) e a API do Railway para tudo mais.
# Toda variável VITE_* é embutida no bundle publicado — nunca coloque segredo aqui.

# URL da API publicada no Railway (produção) ou http://localhost:3001 (local).
VITE_API_URL=http://localhost:3001

# Projeto Supabase — só para autenticação (supabase.auth.*), nunca para dados de negócio.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# "PRODUÇÃO" ou "DEMONSTRAÇÃO" — mostrado na tela de login (seção 18).
VITE_APP_ENVIRONMENT=DEMONSTRAÇÃO
